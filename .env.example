# Local-only sample values for docker compose. Copy to .env (gitignored).
# Placeholders only: never commit real credentials.
PP_LOG_LEVEL=info
POSTGRES_USER=pp
POSTGRES_PASSWORD=pp-local-only
POSTGRES_DB=pp
# Host ports published on 127.0.0.1.
PP_PROXY_PORT=8000
PP_API_HOST_PORT=8080
PP_WEB_HOST_PORT=5173
PP_POSTGRES_HOST_PORT=5432

# Match the exact URL used in the browser (no trailing slash).
PP_APP_ORIGIN=http://localhost:8000
PP_SESSION_IDLE_TIMEOUT=30d
PP_SESSION_COOKIE_SECURE=false
